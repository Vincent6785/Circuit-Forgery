// Profil moto "anti grands axes". Seul "max_speed connu ET > 80" est une exclusion
// dure (multiply_by 0) : c'est le critère exact demandé par l'utilisateur.
//
// Deux pièges rencontrés en développement (import complet France, cf. logs
// PrepareRoutingSubnetworks) qui fragmentaient le graphe en ~970 composantes
// disjointes au lieu d'un seul réseau connecté :
//  1. Exclure totalement (multiply_by 0) road_class == MOTORWAY/TRUNK : certaines
//     routes nationales tagguées TRUNK sont l'unique liaison viable entre régions
//     même à vitesse <= 80. -> road_class ne fait plus que pénaliser, jamais exclure.
//  2. "max_speed > 80" tout court : GraphHopper encode un maxspeed absent (très
//     fréquent sur les petites routes rurales/communales françaises, qui n'ont pas
//     toujours de tag maxspeed explicite) comme +infini (use_maximum_as_infinity),
//     donc "max_speed > 80" excluait AUSSI toutes les routes sans tag de vitesse !
//     -> on ajoute "&& max_speed < 1000" pour ne cibler que les vitesses réellement
//     connues et élevées ; les routes sans tag retombent alors sur les règles
//     road_class (unclassified/residential/tertiary -> priorisées).
{
  "distance_influence": 30,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },

    { "if": "max_speed > 80 && max_speed < 1000", "multiply_by": "0" },
    { "else_if": "max_speed > 70 && max_speed < 1000", "multiply_by": "0.3" },
    { "else_if": "road_class == SECONDARY", "multiply_by": "1.1" },
    { "else_if": "road_class == TERTIARY", "multiply_by": "1.2" },
    { "else_if": "road_class == UNCLASSIFIED || road_class == RESIDENTIAL", "multiply_by": "1.3" },

    { "if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0.02" },
    { "else_if": "road_class == PRIMARY", "multiply_by": "0.1" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed" }
  ]
}
